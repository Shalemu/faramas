class AdModel {
  final int id;
  final String title;
  final bool active;
  final String image;

  AdModel({
    required this.id,
    required this.title,
    required this.active,
    required this.image,
  });

  factory AdModel.fromJson(Map<String, dynamic> json) {
    return AdModel(
      id: json['id'],
      title: json['title'],
      active: json['active'],
      image: json['image'], // relative path like /media/ads/4.jpg
    );
  }
}
